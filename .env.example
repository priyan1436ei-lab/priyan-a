# -----------------------------------------------------------------
# FinFam Enterprise Financial Configuration
# -----------------------------------------------------------------

# Payment Mode: 'test' for simulation/test keys, 'live' for real payments
PAYMENTS_MODE=test

# Live Mode Safety Gate: Must be explicitly set to 'true' to allow real money payouts
ENABLE_REAL_MONEY_TRANSFERS=false

# Razorpay Standard Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX Payouts Engine (Requires approved merchant KYC)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Supabase PostgreSQL & Realtime Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Server Ports & Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Transactional Email (Invitations & Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SIMULATE_EMAIL_FAILURES=false
